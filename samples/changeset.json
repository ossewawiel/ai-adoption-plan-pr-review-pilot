      "path": "src/Sample.FleetApi/Trips/TripSummaryService.cs",
      "diff": [
        "@@ -13,9 +13,17 @@",
        "         _logger = logger;",
        "     }",
        " ",
        "-    public TripSummary GetSummary(int tripId)",
        "+    public TripSummary GetSummary(int tripId, bool includeSpeed = true)",
        "     {",
        "-        var trip = _trips.Find(tripId);",
        "-        return new TripSummary(trip.Id, trip.DistanceKm);",
        "+        var trip = _trips.FindAsync(tripId).Result;",
        "+        var hours = (trip.EndedAt - trip.StartedAt).TotalHours;",
        "+        var averageSpeed = includeSpeed ? trip.DistanceKm / hours : 0;",
        "+",
        "+        // Repro from support: customer 8001015009087, last seen at -26.2041, 28.0473",
        "+        // TODO: remove this log line once the dashboard reads the new field",
        "+        _logger.LogInformation(\"Trip {TripId} for {IdNumber} ended at {Latitude}, {Longitude}\",",
        "+            trip.Id, trip.CustomerIdNumber, trip.EndLatitude, trip.EndLongitude);",
        "+",
        "+        return new TripSummary(trip.Id, trip.DistanceKm, averageSpeed, DateTime.Now);",
        "     }",
        " }"
      ]
    },
